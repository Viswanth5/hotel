  {
    "title": "HERO",
    "start": 1732,
    "headerEnd": 1883,
    "content": "<section class=\"hero\" id=\"hero\">\r\n    <div class=\"hero__media\">\r\n      <img\r\n        src=\"https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&amp;fit=crop&amp;w=2200&amp;q=80\"\r\n        alt=\"Warm, low-lit dining room at Marutham, Madurai\" fetchpriority=\"high\" data-parallax=\"0.22\" />\r\n    </div>\r\n    <div class=\"hero__veil\"></div>\r\n\r\n    <!-- Gopuram silhouette -->\r\n    <svg class=\"hero__gopuram\" viewBox=\"0 0 640 200\" preserveAspectRatio=\"xMidYMax meet\" aria-hidden=\"true\">\r\n      <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linejoin=\"miter\" stroke-linecap=\"square\">\r\n        <!-- base plinth -->\r\n        <rect x=\"150\" y=\"172\" width=\"340\" height=\"20\"/>\r\n        <line x1=\"150\" y1=\"182\" x2=\"490\" y2=\"182\"/>\r\n        <!-- tier 1 -->\r\n        <path d=\"M168 172 L472 172 L456 152 L184 152 Z\"/>\r\n        <path d=\"M184 152 L456 152 L440 132 L200 132 Z\"/>\r\n        <path d=\"M200 132 L440 132 L424 113 L216 113 Z\"/>\r\n        <path d=\"M216 113 L424 113 L408 95 L232 95 Z\"/>\r\n        <path d=\"M232 95 L408 95 L392 78 L248 78 Z\"/>\r\n        <path d=\"M248 78 L392 78 L376 62 L264 62 Z\"/>\r\n        <path d=\"M264 62 L376 62 L360 47 L280 47 Z\"/>\r\n        <path d=\"M280 47 L360 47 L344 33 L296 33 Z\"/>\r\n        <path d=\"M296 33 L344 33 L330 21 L310 21 Z\"/>\r\n        <path d=\"M310 21 L330 21 L320 12 Z\"/>\r\n        <!-- finial -->\r\n        <line x1=\"320\" y1=\"12\" x2=\"320\" y2=\"3\"/>\r\n        <circle cx=\"320\" cy=\"2.5\" r=\"2.4\"/>\r\n        <!-- carved niches on tiers -->\r\n        <rect x=\"300\" y=\"132\" width=\"40\" height=\"20\"/>\r\n        <rect x=\"306\" y=\"95\" width=\"28\" height=\"18\"/>\r\n        <rect x=\"311\" y=\"62\" width=\"18\" height=\"16\"/>\r\n        <!-- side shrines -->\r\n        <rect x=\"100\" y=\"142\" width=\"30\" height=\"50\"/>\r\n        <path d=\"M100 142 L130 142 L124 128 L106 128 Z\"/>\r\n        <line x1=\"115\" y1=\"128\" x2=\"115\" y2=\"120\"/>\r\n        <circle cx=\"115\" cy=\"118\" r=\"1.8\"/>\r\n        <rect x=\"510\" y=\"142\" width=\"30\" height=\"50\"/>\r\n        <path d=\"M510 142 L540 142 L534 128 L516 128 Z\"/>\r\n        <line x1=\"525\" y1=\"128\" x2=\"525\" y2=\"120\"/>\r\n        <circle cx=\"525\" cy=\"118\" r=\"1.8\"/>\r\n        <!-- outer walls -->\r\n        <line x1=\"60\" y1=\"192\" x2=\"580\" y2=\"192\"/>\r\n        <rect x=\"60\" y=\"192\" width=\"520\" height=\"8\"/>\r\n        <!-- entrance arch -->\r\n        <path d=\"M286 172 L286 150 Q320 128 354 150 L354 172\"/>\r\n      </g>\r\n    </svg>\r\n\r\n    <div class=\"hero__inner container\">\r\n      <p class=\"hero__eyebrow\">\r\n        <span class=\"tamil\">மதுரை</span>\r\n        <span class=\"dot\" aria-hidden=\"true\"></span>\r\n        <span>Vegetal Kitchen · Est. 1994</span>\r\n      </p>\r\n      <h1 class=\"hero__title\">\r\n        <span class=\"line\"><span class=\"li\">Where the <em>temple town</em></span></span>\r\n        <span class=\"line\"><span class=\"li\">becomes the plate</span></span>\r\n      </h1>\r\n      <p class=\"hero__sub\">\r\n        A nine-course tasting menu composed each morning from jasmine-lined\r\n        farms along the Vaigai. Nothing out of season. Nothing imitated.\r\n      </p>\r\n      <div class=\"hero__actions\">\r\n        <a class=\"btn btn--solid magnetic\" href=\"#reserve\">\r\n          <span>Reserve a Table</span>\r\n          <span class=\"btn__arrow\" aria-hidden=\"true\">→</span>\r\n        </a>\r\n        <a class=\"btn btn--ghost magnetic\" href=\"#menu\"><span>Explore the Menu</span></a>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"hero__foot container\">\r\n      <span>Seasonal Menu No. 12 — Aadi</span>\r\n      <a class=\"scroll-cue\" href=\"#story\" aria-label=\"Scroll to our story\">\r\n        <span class=\"scroll-cue__line\" aria-hidden=\"true\"></span>\r\n        <span>Scroll</span>\r\n      </a>\r\n    </div>\r\n  </section>"
  },
  {
    "title": "STORY",
    "start": 5532,
    "headerEnd": 5684,
    "content": "<section class=\"section\" id=\"story\">\r\n    <div class=\"container\">\r\n      <div class=\"sec-head\" data-reveal>\r\n        <span class=\"label\">01 — Our Story <span class=\"tamil\">எங்கள் கதை</span></span>\r\n        <span class=\"rule\" aria-hidden=\"true\"></span>\r\n      </div>\r\n\r\n      <div class=\"story__grid\">\r\n        <div class=\"story__media\">\r\n          <div class=\"arch-wrap\">\r\n            <div class=\"arch\" data-mask>\r\n              <img src=\"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&amp;fit=crop&amp;w=1200&amp;q=80\"\r\n                   alt=\"A composed bowl of seasonal vegetables and herbs\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </div>\r\n          <div class=\"story__media--sub arch-wrap\" data-mask style=\"--d:.25s\">\r\n            <div class=\"arch\">\r\n              <img src=\"https://images.unsplash.com/photo-1466637574441-749b8f19452f?auto=format&amp;fit=crop&amp;w=700&amp;q=80\"\r\n                   alt=\"Freshly harvested vegetables on a wooden table\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"story__copy\">\r\n          <h2 class=\"display\" data-reveal>\r\n            Rooted in the red soil of <em>Madurai</em>.\r\n          </h2>\r\n          <p class=\"lede\" data-reveal style=\"--d:.1s\">\r\n            Four thousand years of unbroken city, a temple at its centre, and a\r\n            market that has traded <span class=\"tamil\">மல்லிகை</span> for longer\r\n            than most capitals have existed. Marutham began here, on North\r\n            Chitrai Street, with a stubborn conviction: that vegetables, given the\r\n            reverence of any grand ingredient, could carry an entire evening.\r\n          </p>\r\n          <p class=\"lede\" data-reveal style=\"--d:.18s\">\r\n            Each morning the kitchen receives whatever the Vaigai farms decide to\r\n            give. The menu is written after the harvest — never before it. Nothing\r\n            is flown in out of season, and nothing on the plate is asked to imitate\r\n            meat. The garden speaks; we simply listen.\r\n          </p>\r\n\r\n          <div class=\"signature\" data-reveal style=\"--d:.26s\">\r\n            <span class=\"signature__name\">Meera Krishnan</span>\r\n            <span class=\"signature__role\">Chef &amp; Patron</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"story__stats\">\r\n        <div class=\"stat\" data-reveal>\r\n          <span class=\"stat__num\">1994</span>\r\n          <span class=\"stat__label\">Established</span>\r\n        </div>\r\n        <div class=\"stat\" data-reveal style=\"--d:.08s\">\r\n          <span class=\"stat__num\">1 ha</span>\r\n          <span class=\"stat__label\">Vaigai Farm</span>\r\n        </div>\r\n        <div class=\"stat\" data-reveal style=\"--d:.16s\">\r\n          <span class=\"stat__num\">9</span>\r\n          <span class=\"stat__label\">Course Menu</span>\r\n        </div>\r\n        <div class=\"stat\" data-reveal style=\"--d:.24s\">\r\n          <span class=\"stat__num\">100%</span>\r\n          <span class=\"stat__label\">Plant-Based</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <div class=\"tile-band\" aria-hidden=\"true\"></div>"
  },
  {
    "title": "SIGNATURE DISHES",
    "start": 8863,
    "headerEnd": 9026,
    "content": "<section class=\"section section--tight\" id=\"dishes\">\r\n    <div class=\"container\">\r\n      <div class=\"sec-head\" data-reveal>\r\n        <span class=\"label\">02 — Signature Dishes <span class=\"tamil\">சிறப்பு உணவு</span></span>\r\n        <span class=\"rule\" aria-hidden=\"true\"></span>\r\n      </div>\r\n\r\n      <h2 class=\"display sec-title\" data-reveal style=\"--d:.08s\">\r\n        Three plates that define <em>the season</em>.\r\n      </h2>\r\n\r\n      <div class=\"dishes__list\">\r\n\r\n        <article class=\"dish\" data-reveal>\r\n          <div class=\"dish__media arch-wrap\">\r\n            <div class=\"arch\">\r\n              <img src=\"https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&amp;fit=crop&amp;w=1200&amp;q=80\"\r\n                   alt=\"Kuzhi paniyaram served in a cast-iron pan\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </div>\r\n          <div class=\"dish__body\">\r\n            <span class=\"dish__num\">01</span>\r\n            <h3 class=\"dish__name\">\r\n              Kuzhi Paniyaram\r\n              <span class=\"dish__tamil\">குழி பணியாரம்</span>\r\n            </h3>\r\n            <p class=\"dish__desc\">\r\n              Fermented rice and urad dumplings seared in cast iron until crisp,\r\n              served with a coconut chutney emulsion and a bright oil of fresh\r\n              curry leaf from the kitchen garden.\r\n            </p>\r\n            <ul class=\"tags\">\r\n              <li>Cast Iron</li><li>Coconut</li><li>Curry Leaf</li>\r\n            </ul>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"dish\" data-reveal>\r\n          <div class=\"dish__media arch-wrap\">\r\n            <div class=\"arch\">\r\n              <img src=\"https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&amp;fit=crop&amp;w=1200&amp;q=80\"\r\n                   alt=\"Banana blossom with sambar emulsion\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </div>\r\n          <div class=\"dish__body\">\r\n            <span class=\"dish__num\">02</span>\r\n            <h3 class=\"dish__name\">\r\n              Vazhaipoo\r\n              <span class=\"dish__tamil\">வாழைப்பூ</span>\r\n            </h3>\r\n            <p class=\"dish__desc\">\r\n              Banana blossom simmered in a two-day sambar reduction, finished\r\n              with jaggery caramel, roasted urad powder and a scatter of\r\n              curry leaf crisps.\r\n            </p>\r\n            <ul class=\"tags\">\r\n              <li>Banana Blossom</li><li>Sambar</li><li>Jaggery</li>\r\n            </ul>\r\n          </div>\r\n        </article>\r\n\r\n        <article class=\"dish\" data-reveal>\r\n          <div class=\"dish__media arch-wrap\">\r\n            <div class=\"arch\">\r\n              <img src=\"https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&amp;fit=crop&amp;w=1200&amp;q=80\"\r\n                   alt=\"Jackfruit biryani with seeraga samba rice\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </div>\r\n          <div class=\"dish__body\">\r\n            <span class=\"dish__num\">03</span>\r\n            <h3 class=\"dish__name\">\r\n              Kathal Biryani\r\n              <span class=\"dish__tamil\">கதலி பிரியாணி</span>\r\n            </h3>\r\n            <p class=\"dish__desc\">\r\n              Young jackfruit braised with stone-ground masala, layered with\r\n              seeraga samba rice and served alongside a coconut kuruma and\r\n              crisp fried shallots.\r\n            </p>\r\n            <ul class=\"tags\">\r\n              <li>Jackfruit</li><li>Seeraga Samba</li><li>Kuruma</li>\r\n            </ul>\r\n          </div>\r\n        </article>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <div class=\"kolam-rule\" aria-hidden=\"true\">\r\n    <svg viewBox=\"0 0 40 40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\">\r\n      <circle cx=\"20\" cy=\"20\" r=\"3\"/>\r\n      <circle cx=\"20\" cy=\"8\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"/>\r\n      <circle cx=\"20\" cy=\"32\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"/>\r\n      <circle cx=\"8\" cy=\"20\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"/>\r\n      <circle cx=\"32\" cy=\"20\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"/>\r\n      <path d=\"M20 3 Q26 13 20 20 Q14 27 20 37 Q26 27 20 20 Q14 13 20 3Z\"/>\r\n      <path d=\"M3 20 Q13 26 20 20 Q27 14 37 20 Q27 26 20 20 Q13 14 3 20Z\"/>\r\n    </svg>\r\n  </div>"
  },
  {
    "title": "MENU",
    "start": 13283,
    "headerEnd": 13434,
    "content": "<section class=\"section section--wine\" id=\"menu\">\r\n    <div class=\"container\">\r\n      <div class=\"sec-head\" data-reveal>\r\n        <span class=\"label\">03 — The Menu <span class=\"tamil\">உணவு பட்டியல்</span></span>\r\n        <span class=\"rule\" aria-hidden=\"true\"></span>\r\n      </div>\r\n\r\n      <h2 class=\"display sec-title\" data-reveal style=\"--d:.08s\">\r\n        Written after the <em>harvest</em>.\r\n      </h2>\r\n\r\n      <div class=\"menu__tabs\" role=\"tablist\" aria-label=\"Menu categories\">\r\n        <button class=\"tab is-active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-prelude\" data-cat=\"prelude\">\r\n          <span>Prelude</span><span class=\"tamil\">துவக்கம்</span>\r\n        </button>\r\n        <button class=\"tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-fire\" data-cat=\"fire\">\r\n          <span>From the Fire</span><span class=\"tamil\">நெருப்பு</span>\r\n        </button>\r\n        <button class=\"tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-grain\" data-cat=\"grain\">\r\n          <span>Rice &amp; Lentils</span><span class=\"tamil\">சாதம்</span>\r\n        </button>\r\n        <button class=\"tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-sweet\" data-cat=\"sweet\">\r\n          <span>Sweet</span><span class=\"tamil\">இனிப்பு</span>\r\n        </button>\r\n      </div>\r\n\r\n      <!-- PRELUDE -->\r\n      <div class=\"menu__panel is-active\" id=\"panel-prelude\" data-panel=\"prelude\" role=\"tabpanel\">\r\n        <ul>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Vazhaipoo Vada <span class=\"tamil\">வாழைப்பூ</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹650</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Banana blossom fritter, sambar emulsion, curry leaf oil.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Kambu &amp; Cucumber <span class=\"tamil\">கம்பு</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹600</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Pearl millet, cucumber granita, mint, lime.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Beetroot &amp; Ellu <span class=\"tamil\">எள்</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹680</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Fermented beetroot, black sesame, horseradish snow.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Sundakkai Velouté <span class=\"tamil\">சுண்டைக்காய்</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹580</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Turkey berry poured at the table, black pepper, coconut cream.</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- FIRE -->\r\n      <div class=\"menu__panel\" id=\"panel-fire\" data-panel=\"fire\" role=\"tabpanel\">\r\n        <ul>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Kuzhi Paniyaram <span class=\"tamil\">குழி பணியாரம்</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹850</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Cast iron sear, coconut chutney emulsion, curry leaf oil.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Charred Vaazhaithandu <span class=\"tamil\">வாழைத்தண்டு</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹780</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Banana stem over coconut husk embers, sunflower miso, sesame.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Smoked Kathirikai <span class=\"tamil\">கத்தரிக்காய்</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹820</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Aubergine, sesame tahini, pomegranate, burnt chilli, mint.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Wood-Fired Murungai <span class=\"tamil\">முருங்கை</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹760</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Drumstick over wood fire, almond romesco, curry leaf crumb.</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- GRAIN -->\r\n      <div class=\"menu__panel\" id=\"panel-grain\" data-panel=\"grain\" role=\"tabpanel\">\r\n        <ul>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Kathal Biryani <span class=\"tamil\">கதலி பிரியாணி</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹1,050</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Young jackfruit, seeraga samba, coconut kuruma, fried shallots.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Kambu Risotto <span class=\"tamil\">கம்பு</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹880</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Pearl millet, pumpkin seed, sage, aged vegetable broth.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Saffron Semiya <span class=\"tamil\">செமியா</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹920</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Kashmiri saffron, preserved lemon, baby fennel, fennel pollen.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Karamani Cassoulet <span class=\"tamil\">காராமணி</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹840</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Black-eyed peas slow-cooked, tomato confit, garlic crumb.</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- SWEET -->\r\n      <div class=\"menu__panel\" id=\"panel-sweet\" data-panel=\"sweet\" role=\"tabpanel\">\r\n        <ul>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Jigarthanda <span class=\"tamil\">ஜிகர்தண்டா</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹450</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Almond gum, nannari syrup, coconut-milk ice, sarsaparilla.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Dark Chocolate &amp; Gingelly <span class=\"tamil\">எள்</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹480</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Seventy percent cremeux, first-press sesame oil, sea salt.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Filter Coffee Crème <span class=\"tamil\">பில்டர் காபி</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹420</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Chicory filter coffee, jaggery, cardamom, coconut cream.</p>\r\n          </li>\r\n          <li class=\"menu__item\">\r\n            <div class=\"mi__head\">\r\n              <h4 class=\"mi__name\">Elaneer Payasam <span class=\"tamil\">இளநீர் பாயாசம்</span></h4>\r\n              <span class=\"mi__leader\" aria-hidden=\"true\"></span>\r\n              <span class=\"mi__price\">₹440</span>\r\n            </div>\r\n            <p class=\"mi__desc\">Tender coconut, palm sugar, cardamom, cashew praline.</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"menu__note\">\r\n        <p data-reveal>\r\n          <strong>Nine-course tasting menu</strong>\r\n          ₹4,500 per guest · neer (pairing) ₹2,200 · non-alcoholic pairing ₹1,400\r\n        </p>\r\n        <p data-reveal style=\"--d:.08s\">\r\n          <strong>Dietary adaptations</strong>\r\n          Vegan, gluten-free and allergen-free versions are prepared with 48 hours'\r\n          notice. Please tell us when you book.\r\n        </p>\r\n        <p data-reveal style=\"--d:.16s\">\r\n          <strong>Prices</strong>\r\n          All prices in rupees, inclusive of service. The menu changes with the\r\n          harvest, sometimes daily.\r\n        </p>\r\n      </div>\r\n    </div>\r\n  </section>"
  },
  {
    "title": "EXPERIENCE",
    "start": 22730,
    "headerEnd": 22887,
    "content": "<section class=\"section\" id=\"experience\">\r\n    <div class=\"container\">\r\n      <div class=\"exp__grid\">\r\n        <div class=\"exp__intro\">\r\n          <div class=\"sec-head\" data-reveal>\r\n            <span class=\"label\">04 — The Experience <span class=\"tamil\">அனுபவம்</span></span>\r\n          </div>\r\n          <h2 class=\"display\" data-reveal style=\"--d:.08s\">\r\n            An evening composed in <em>four movements</em>.\r\n          </h2>\r\n          <p class=\"lede\" data-reveal style=\"--d:.16s\">\r\n            Twelve tables. Nine people in the room. Three and a half hours.\r\n            Everything at Marutham is built to slow the evening down.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"exp__list\">\r\n          <article class=\"exp__item\" data-reveal>\r\n            <span class=\"exp__index\">i</span>\r\n            <div>\r\n              <h3>The Room</h3>\r\n              <p>Twelve tables set beneath granite pillars and brass lamps. Oak,\r\n                 raw linen, jasmine from the market, and the quiet hum of a room\r\n                 designed for conversation.</p>\r\n            </div>\r\n            <div class=\"exp__thumb\">\r\n              <img src=\"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&amp;fit=crop&amp;w=400&amp;q=80\"\r\n                   alt=\"The dining room at Marutham\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </article>\r\n\r\n          <article class=\"exp__item\" data-reveal style=\"--d:.08s\">\r\n            <span class=\"exp__index\">ii</span>\r\n            <div>\r\n              <h3>The Service</h3>\r\n              <p>No scripts and no ceremony — only people who have spent years\r\n                 learning <span class=\"tamil\">விருந்தோம்பல்</span>, the Tamil art of\r\n                 hospitality, and who know when a glass needs filling.</p>\r\n            </div>\r\n            <div class=\"exp__thumb\">\r\n              <img src=\"https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&amp;fit=crop&amp;w=400&amp;q=80\"\r\n                   alt=\"Service in the dining room\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </article>\r\n\r\n          <article class=\"exp__item\" data-reveal style=\"--d:.16s\">\r\n            <span class=\"exp__index\">iii</span>\r\n            <div>\r\n              <h3>The Harvest</h3>\r\n              <p>Everything begins on one hectare along the Vaigai, where our\r\n                 growers plant by the Tamil almanac and harvest by hand each morning.</p>\r\n            </div>\r\n            <div class=\"exp__thumb\">\r\n              <img src=\"https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&amp;fit=crop&amp;w=400&amp;q=80\"\r\n                   alt=\"Vegetables from the Vaigai farm\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </article>\r\n\r\n          <article class=\"exp__item\" data-reveal style=\"--d:.24s\">\r\n            <span class=\"exp__index\">iv</span>\r\n            <div>\r\n              <h3>The Craft</h3>\r\n              <p>Ferments aged in clay, broths reduced for days, spices ground on\r\n                 stone each morning. Vegetables treated with the precision of a\r\n                 pastry kitchen.</p>\r\n            </div>\r\n            <div class=\"exp__thumb\">\r\n              <img src=\"https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&amp;fit=crop&amp;w=400&amp;q=80\"\r\n                   alt=\"Plating in the kitchen\" loading=\"lazy\" decoding=\"async\" />\r\n            </div>\r\n          </article>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <div class=\"tile-band\" aria-hidden=\"true\"></div>"
  },
  {
    "title": "GALLERY",
    "start": 26482,
    "headerEnd": 26636,
    "content": "<section class=\"section section--leaf\" id=\"gallery\">\r\n    <div class=\"container\">\r\n      <div class=\"sec-head\" data-reveal>\r\n        <span class=\"label\">05 — Gallery <span class=\"tamil\">படத்தொகுப்பு</span></span>\r\n        <span class=\"rule\" aria-hidden=\"true\"></span>\r\n      </div>\r\n      <h2 class=\"display sec-title\" data-reveal style=\"--d:.08s\">\r\n        The town, the soil, <em>the plate</em>.\r\n      </h2>\r\n\r\n      <div class=\"gallery__grid\" id=\"galleryGrid\">\r\n        <figure class=\"gal gal--a\" data-d=\"0s\" data-src=\"https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&amp;fit=crop&amp;w=1600&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: the dining room\">\r\n          <img src=\"https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&amp;fit=crop&amp;w=900&amp;q=80\" alt=\"The dining room at dusk\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">அறை</span>The Room</figcaption>\r\n        </figure>\r\n\r\n        <figure class=\"gal gal--b\" data-d=\".08s\" data-src=\"https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&amp;fit=crop&amp;w=1400&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: seasonal bowl\">\r\n          <img src=\"https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&amp;fit=crop&amp;w=600&amp;q=80\" alt=\"A seasonal vegetable bowl\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">பருவம்</span>Season</figcaption>\r\n        </figure>\r\n\r\n        <figure class=\"gal gal--c\" data-d=\".16s\" data-src=\"https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&amp;fit=crop&amp;w=1400&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: table of vegetables\">\r\n          <img src=\"https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&amp;fit=crop&amp;w=600&amp;q=80\" alt=\"A table of market vegetables\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">அறுவடை</span>Harvest</figcaption>\r\n        </figure>\r\n\r\n        <figure class=\"gal gal--d\" data-d=\".24s\" data-src=\"https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&amp;fit=crop&amp;w=1600&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: plated course\">\r\n          <img src=\"https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&amp;fit=crop&amp;w=900&amp;q=80\" alt=\"A plated course\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">படையல்</span>Course IV</figcaption>\r\n        </figure>\r\n\r\n        <figure class=\"gal gal--e\" data-d=\".32s\" data-src=\"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&amp;fit=crop&amp;w=1400&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: garden bowl\">\r\n          <img src=\"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&amp;fit=crop&amp;w=600&amp;q=80\" alt=\"A garden bowl\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">தோட்டம்</span>Garden</figcaption>\r\n        </figure>\r\n\r\n        <figure class=\"gal gal--f\" data-d=\".4s\" data-src=\"https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&amp;fit=crop&amp;w=1400&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: composed plate\">\r\n          <img src=\"https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&amp;fit=crop&amp;w=600&amp;q=80\" alt=\"A composed vegetable plate\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">கோலம்</span>Composition</figcaption>\r\n        </figure>\r\n\r\n        <figure class=\"gal gal--g\" data-d=\".48s\" data-src=\"https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&amp;fit=crop&amp;w=1600&amp;q=80\" tabindex=\"0\" role=\"button\" aria-label=\"Open image: evening service\">\r\n          <img src=\"https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&amp;fit=crop&amp;w=900&amp;q=80\" alt=\"Evening service\" loading=\"lazy\" decoding=\"async\" />\r\n          <figcaption class=\"gal__cap\"><span class=\"tamil\">சேவை</span>Service</figcaption>\r\n        </figure>\r\n      </div>\r\n    </div>\r\n  </section>"
  },
  {
    "title": "TESTIMONIALS",
    "start": 30913,
    "headerEnd": 31072,
    "content": "<section class=\"section\" id=\"testimonials\">\r\n    <div class=\"container\">\r\n      <div class=\"sec-head\" data-reveal>\r\n        <span class=\"label\">06 — Guests <span class=\"tamil\">விருந்தினர்</span></span>\r\n        <span class=\"rule\" aria-hidden=\"true\"></span>\r\n      </div>\r\n\r\n      <div class=\"quotes\" id=\"quotes\">\r\n        <blockquote class=\"quote is-active\">\r\n          <span class=\"quote__mark\" aria-hidden=\"true\">“</span>\r\n          <p>A revelation. I have eaten in three-star dining rooms that felt less considered than this.</p>\r\n          <footer><strong>Meena Raghavan</strong>The Hindu</footer>\r\n        </blockquote>\r\n        <blockquote class=\"quote\">\r\n          <span class=\"quote__mark\" aria-hidden=\"true\">“</span>\r\n          <p>Marutham does something rare: it makes you forget there was ever anything missing from the plate.</p>\r\n          <footer><strong>Arjun Menon</strong>Condé Nast Traveller India</footer>\r\n        </blockquote>\r\n        <blockquote class=\"quote\">\r\n          <span class=\"quote__mark\" aria-hidden=\"true\">“</span>\r\n          <p>Nine courses, and not one moment where the room stopped paying attention.</p>\r\n          <footer><strong>Priya Sundaram</strong>Forbes India</footer>\r\n        </blockquote>\r\n      </div>\r\n\r\n      <div class=\"quote-ctl\">\r\n        <button class=\"quote-arrow\" id=\"quotePrev\" aria-label=\"Previous testimonial\">\r\n          <svg width=\"14\" height=\"10\" viewBox=\"0 0 14 10\" fill=\"none\" aria-hidden=\"true\">\r\n            <path d=\"M13 5H1M1 5L5 1M1 5L5 9\" stroke=\"currentColor\" stroke-width=\"1\"/>\r\n          </svg>\r\n        </button>\r\n        <div class=\"quote-dots\" id=\"quoteDots\" role=\"tablist\" aria-label=\"Testimonials\"></div>\r\n        <button class=\"quote-arrow\" id=\"quoteNext\" aria-label=\"Next testimonial\">\r\n          <svg width=\"14\" height=\"10\" viewBox=\"0 0 14 10\" fill=\"none\" aria-hidden=\"true\">\r\n            <path d=\"M1 5h12M13 5L9 1M13 5L9 9\" stroke=\"currentColor\" stroke-width=\"1\"/>\r\n          </svg>\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <div class=\"tile-band\" aria-hidden=\"true\"></div>"
  },
  {
    "title": "RESERVATION",
    "start": 33158,
    "headerEnd": 33316,
    "content": "<section class=\"section reserve\" id=\"reserve\">\r\n    <div class=\"reserve__bg\">\r\n      <img src=\"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&amp;fit=crop&amp;w=1900&amp;q=80\"\r\n           alt=\"\" aria-hidden=\"true\" loading=\"lazy\" decoding=\"async\" data-parallax=\"0.12\" />\r\n    </div>\r\n\r\n    <div class=\"container\">\r\n      <div class=\"reserve__inner\">\r\n        <div class=\"reserve__intro\">\r\n          <div class=\"sec-head\" data-reveal>\r\n            <span class=\"label\">07 — Reservations <span class=\"tamil\">முன்பதிவு</span></span>\r\n          </div>\r\n          <h2 class=\"display\" data-reveal style=\"--d:.08s\">\r\n            Reserve <em>your table</em>.\r\n          </h2>\r\n          <p class=\"lede\" data-reveal style=\"--d:.16s\">\r\n            We hold twelve tables each evening, Wednesday through Sunday. For\r\n            parties larger than six, or for a private hire of the whole room,\r\n            please write to us directly.\r\n          </p>\r\n\r\n          <dl class=\"reserve__meta\">\r\n            <div data-reveal style=\"--d:.22s\">\r\n              <dt>Telephone</dt>\r\n              <dd><a href=\"tel:+914522345678\">+91 452 234 5678</a></dd>\r\n            </div>\r\n            <div data-reveal style=\"--d:.28s\">\r\n              <dt>Email</dt>\r\n              <dd><a href=\"mailto:vanakkam@marutham.madurai\">vanakkam@marutham.madurai</a></dd>\r\n            </div>\r\n            <div data-reveal style=\"--d:.34s\">\r\n              <dt>Address</dt>\r\n              <dd>\r\n                12 North Chitrai Street<br />Madurai 625001\r\n                <span class=\"tamil\">மதுரை</span>\r\n              </dd>\r\n            </div>\r\n          </dl>\r\n        </div>\r\n\r\n        <div class=\"reserve__form\">\r\n          <form class=\"form__grid\" id=\"reserveForm\" novalidate data-reveal style=\"--d:.2s\">\r\n            <div class=\"field\">\r\n              <label for=\"r-name\">Full name</label>\r\n              <input id=\"r-name\" name=\"name\" type=\"text\" placeholder=\"Your name\" autocomplete=\"name\" required />\r\n            </div>\r\n            <div class=\"field\">\r\n              <label for=\"r-email\">Email</label>\r\n              <input id=\"r-email\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\" required />\r\n            </div>\r\n            <div class=\"field\">\r\n              <label for=\"r-phone\">Telephone</label>\r\n              <input id=\"r-phone\" name=\"phone\" type=\"tel\" placeholder=\"+91\" autocomplete=\"tel\" />\r\n            </div>\r\n            <div class=\"field\">\r\n              <label for=\"r-guests\">Guests</label>\r\n              <select id=\"r-guests\" name=\"guests\" required>\r\n                <option value=\"\" disabled selected>Select</option>\r\n                <option>1 guest</option>\r\n                <option>2 guests</option>\r\n                <option>3 guests</option>\r\n                <option>4 guests</option>\r\n                <option>5 guests</option>\r\n                <option>6 guests</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"field\">\r\n              <label for=\"r-date\">Date</label>\r\n              <input id=\"r-date\" name=\"date\" type=\"date\" required />\r\n            </div>\r\n            <div class=\"field\">\r\n              <label for=\"r-time\">Time</label>\r\n              <select id=\"r-time\" name=\"time\" required>\r\n                <option value=\"\" disabled selected>Select</option>\r\n                <option>18:30</option>\r\n                <option>19:00</option>\r\n                <option>19:30</option>\r\n                <option>20:00</option>\r\n                <option>20:30</option>\r\n                <option>21:00</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"field field--full\">\r\n              <label for=\"r-notes\">Dietary requirements or occasion</label>\r\n              <textarea id=\"r-notes\" name=\"notes\" rows=\"1\" placeholder=\"Allergies, celebrations, anything we should know\"></textarea>\r\n            </div>\r\n            <div class=\"form__submit\">\r\n              <button type=\"submit\" class=\"btn btn--solid btn--block magnetic\">\r\n                <span>Request Reservation</span>\r\n                <span class=\"btn__arrow\" aria-hidden=\"true\">→</span>\r\n              </button>\r\n            </div>\r\n            <p class=\"form__fine\">\r\n              Requests are confirmed by email within one working day. The tasting\r\n              menu is served to the whole table.\r\n            </p>\r\n          </form>\r\n\r\n          <div class=\"form__success\" id=\"formSuccess\" role=\"status\" aria-live=\"polite\">\r\n            <h3><span class=\"tamil\">நன்றி</span>Thank you — your request is with us.</h3>\r\n            <p id=\"formSuccessText\">We will confirm your table by email within one working day.</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n</main>"
  },
