    "title": "FOOTER",
    "start": 38083,
    "headerEnd": 38232,
    "content": "<footer class=\"footer\">\r\n  <div class=\"container\">\r\n    <div class=\"footer__grid\">\r\n      <div class=\"footer__brand-col\">\r\n        <span class=\"footer__brand\">MARUTHAM</span>\r\n        <span class=\"footer__brand-tamil\">மருதம்</span>\r\n        <p class=\"footer__brand-sub\">\r\n          A vegetal dining house on North Chitrai Street, Madurai. Nine courses,\r\n          one hectare along the Vaigai, and a menu rewritten every morning.\r\n        </p>\r\n      </div>\r\n\r\n      <div>\r\n        <h4>Visit</h4>\r\n        <address>\r\n          12 North Chitrai Street<br />\r\n          Madurai 625001, Tamil Nadu<br />\r\n          <a href=\"tel:+914522345678\">+91 452 234 5678</a><br />\r\n          <a href=\"mailto:vanakkam@marutham.madurai\">vanakkam@marutham.madurai</a>\r\n        </address>\r\n      </div>\r\n\r\n      <div>\r\n        <h4>Hours</h4>\r\n        <address>\r\n          Wednesday — Sunday<br />\r\n          Dinner 18:30 — 23:00<br />\r\n          Last seating 21:00<br />\r\n          Closed Monday &amp; Tuesday\r\n        </address>\r\n      </div>\r\n\r\n      <div>\r\n        <h4>Follow</h4>\r\n        <div class=\"footer__links\">\r\n          <a href=\"#\" aria-label=\"Marutham on Instagram\">Instagram</a>\r\n          <a href=\"#\" aria-label=\"Marutham on Facebook\">Facebook</a>\r\n          <a href=\"#\" aria-label=\"Marutham on Pinterest\">Pinterest</a>\r\n          <a href=\"#\" aria-label=\"Marutham newsletter\">Newsletter</a>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"footer__bottom\">\r\n      <span>© <span id=\"year\">2024</span> Marutham — All rights reserved</span>\r\n      <a class=\"to-top\" href=\"#hero\">\r\n        <span>Back to top</span>\r\n        <svg width=\"10\" height=\"14\" viewBox=\"0 0 10 14\" fill=\"none\" aria-hidden=\"true\">\r\n          <path d=\"M5 13V1M5 1L1 5M5 1l4 4\" stroke=\"currentColor\" stroke-width=\"1\"/>\r\n        </svg>\r\n      </a>\r\n    </div>\r\n  </div>\r\n</footer>"
